// Cloudflare Workers config: serves this folder as a static site.
// /tires serves tires.html (same clean URLs as on Vercel); files listed in .assetsignore are not published.
// worker.js also runs the daily Supabase keep-alive (cron below, 02:00 UTC) and /api/translate.
{
  "name": "boyautotires",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // these go to worker.js first: photos through Cloudflare's cache, blog articles and
    // products get their own canonical/title, the sitemap lists them all
    "run_worker_first": ["/img/*", "/blog", "/tires", "/alloywheel", "/shock", "/brake", "/other", "/sitemap.xml"]
  },
  // Workers AI, used by /api/translate in worker.js
  "ai": { "binding": "AI" },
  "triggers": {
    "crons": ["0 2 * * *"]
  }
}
