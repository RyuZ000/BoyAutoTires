{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(Photo|Video)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
